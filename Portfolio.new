```html
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Portfolio</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>

<!-- ================= MENU ================= -->

<nav class="sidebar">

    <div class="logo">
        PORTFOLIO
    </div>

    <button onclick="showPage('home')">
        หน้าแรก
    </button>

    <button onclick="showPage('preface')">
        คำนำ
    </button>

    <button onclick="showPage('profile')">
        ประวัติส่วนตัว
    </button>

    <button onclick="showPage('activities')">
        ผลงานและกิจกรรม
    </button>

    <button onclick="showPage('contact')">
        ช่องทางการติดต่อ
    </button>

</nav>


<!-- ================= MAIN ================= -->

<main>


<!-- ================= PAGE 1 ================= -->

<section id="home" class="page active">

    <div class="home-content">

        <h1>WELCOME TO<br>MY PORTFOLIO</h1>

        <p class="subtitle">
            แฟ้มสะสมผลงาน
        </p>

        <!-- ใส่รูปของตัวเอง -->
        <img
            src="images/profile.jpg"
            alt="Profile Image"
            class="profile-image"
        >

        <div class="personal-info">

            <h2>ชื่อ-นามสกุล</h2>

            <p>ชื่อเล่น : ของขวัญ</p>

            <p>ชั้น : ม.6 เลขที่ : 36 XX</p>

            <p>โรงเรียน : บ้านบึง“อุตสาหกรรมนุเคราะห์"</p>

        </div>

    </div>

</section>


<!-- ================= PAGE 2 ================= -->

<section id="preface" class="page">

    <h1 class="page-title">
        คำนำ
    </h1>

    <div class="content-box">

        <h2>แฟ้มสะสมผลงาน (Portfolio)</h2>

        <p>
            แฟ้มสะสมผลงาน (Portfolio) เล่มนี้จัดทำขึ้นเพื่อรวบรวม
            ประวัติส่วนตัว ผลงาน กิจกรรม ประสบการณ์ และความสามารถ
            ที่ข้าพเจ้าได้เรียนรู้และพัฒนาตลอดระยะเวลาที่ผ่านมา
        </p>

        <p>
            ภายในแฟ้มสะสมผลงานเล่มนี้ประกอบด้วยข้อมูลเกี่ยวกับ
            ประวัติส่วนตัว ผลงานที่ภาคภูมิใจ กิจกรรมต่าง ๆ
            รวมถึงเกียรติบัตรและประสบการณ์ที่ได้รับ
        </p>

        <p>
            ข้าพเจ้าหวังเป็นอย่างยิ่งว่าแฟ้มสะสมผลงานเล่มนี้
            จะช่วยแสดงให้เห็นถึงความตั้งใจ ความสามารถ
            และพัฒนาการของข้าพเจ้าได้เป็นอย่างดี
        </p>

    </div>

</section>


<!-- ================= PAGE 3 ================= -->

<section id="profile" class="page">

    <h1 class="page-title">
        ประวัติส่วนตัว
    </h1>

    <div class="content-box">

        <h2>ประวัติส่วนตัว</h2>

        <div class="profile-grid">

            <div>
                <p><strong>ชื่อ-นามสกุล :</strong> ใส่ชื่อของคุณ</p>

                <p><strong>ชื่อเล่น :</strong> ใส่ชื่อเล่น</p>

                <p><strong>วันเกิด :</strong> XX/XX/XXXX</p>

                <p><strong>อายุ :</strong> XX ปี</p>
            </div>

            <div>
                <p><strong>โรงเรียน :</strong> บ้านบึง“อุตสาหกรรมนุเคราะห์”</p>
　
                <p><strong>ระดับชั้น :</strong> ม.6/3</p>

                <p><strong>แผนการเรียน :</strong> MSEP</p>

                <p><strong>งานอดิเรก :</strong> วาดรูป ฟังเพลง อ่านหนังสือ</p>
            </div>

        </div>

    </div>


    <div class="content-box">

        <h2>ความสนใจและเป้าหมาย</h2>

        <p>
            ข้าพเจ้ามีความสนใจในด้านวิทยาศาสตร์ ด้านการสัตวแพทย์
            และการเรียนรู้สิ่งใหม่ ๆ
            โดยมีเป้าหมายที่จะพัฒนาตนเองอย่างต่อเนื่อง
            และนำความรู้ที่ได้รับไปต่อยอดในอนาคต
        </p>

    </div>

</section>


<!-- ================= PAGE 4 ================= -->

<section id="activities" class="page">

    <h1 class="page-title">
        ผลงานและกิจกรรม
    </h1>


    <!-- ผลงานที่ 1 -->

    <div class="activity-card">

        <img
            src="images/certificate1.jpg"
            alt="Certificate 1"
        >

        <div>

            <h2>
                ชื่อผลงาน / เกียรติบัตรที่ 1
            </h2>

            <p>
                ได้เข้าร่วมกิจกรรม....................................
                ซึ่งจัดขึ้นเพื่อ........................................
            </p>

            <p>
                จากกิจกรรมนี้ข้าพเจ้าได้รับประสบการณ์
                และได้พัฒนาทักษะด้าน...............................
            </p>

        </div>

    </div>


    <!-- ผลงานที่ 2 -->

    <div class="activity-card">

        <img
            src="images/certificate2.jpg"
            alt="Certificate 2"
        >

        <div>

            <h2>
                ชื่อผลงาน / เกียรติบัตรที่ 2
            </h2>

            <p>
                ได้เข้าร่วมกิจกรรม....................................
                เมื่อวันที่.............................................
            </p>

            <p>
                สิ่งที่ได้รับจากกิจกรรมนี้คือ...........................
            </p>

        </div>

    </div>


    <!-- ผลงานที่ 3 -->

    <div class="activity-card">

        <img
            src="images/certificate3.jpg"
            alt="Certificate 3"
        >

        <div>

            <h2>
                ชื่อผลงาน / เกียรติบัตรที่ 3
            </h2>

            <p>
                รายละเอียดเกี่ยวกับผลงานหรือกิจกรรม
                สามารถเขียนเพิ่มเติมตรงนี้ได้เลย
            </p>

            <p>
                ประสบการณ์หรือทักษะที่ได้รับจากกิจกรรมนี้
            </p>

        </div>

    </div>

</section>


<!-- ================= PAGE 5 ================= -->

<section id="contact" class="page">

    <h1 class="page-title">
        ช่องทางการติดต่อ
    </h1>

    <div class="contact-box">

        <div class="contact-item">

            <span>✉️</span>

            <div>
                <h2>Gmail</h2>
                <p>yourname@gmail.com</p>
            </div>

        </div>


        <div class="contact-item">

            <span>📱</span>

            <div>
                <h2>Tel</h2>
                <p>08X-XXX-XXXX</p>
            </div>

        </div>


        <div class="contact-item">

            <span>📷</span>

            <div>
                <h2>Instagram</h2>
                <p>@yourusername</p>
            </div>

        </div>

    </div>

</section>

</main>


<script src="script.js"></script>

</body>
</html>
```
```css
/* ================= GENERAL ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Kanit', sans-serif;

    background: #F7F2FA;

    color: #302A35;

    min-height: 100vh;
}


/* ================= SIDEBAR ================= */

.sidebar {

    position: fixed;

    left: 25px;
    top: 50%;

    transform: translateY(-50%);

    width: 210px;

    padding: 18px;

    background: #4B3B5A;

    border-radius: 20px;

    display: flex;

    flex-direction: column;

    gap: 12px;

    box-shadow:
        0 15px 35px rgba(75, 59, 90, 0.25);

    z-index: 1000;
}


.logo {

    color: white;

    font-size: 24px;

    font-weight: 600;

    text-align: center;

    padding: 10px;

    border: 2px solid #C9B8D9;

    border-radius: 10px;

    margin-bottom: 5px;
}


.sidebar button {

    border: 2px solid #C9B8D9;

    background: transparent;

    color: white;

    padding: 12px;

    border-radius: 10px;

    font-family: 'Kanit', sans-serif;

    font-size: 16px;

    cursor: pointer;

    transition: 0.3s;
}


.sidebar button:hover {

    background: #8064A2;

    transform: translateX(5px);
}


/* ================= PAGE ================= */

.page {

    display: none;

    min-height: 100vh;

    padding:

        70px

        8%

        70px

        300px;

    animation: fadeIn 0.5s ease;
}


.page.active {

    display: block;
}


@keyframes fadeIn {

    from {

        opacity: 0;

        transform: translateY(15px);

    }

    to {

        opacity: 1;

        transform: translateY(0);

    }

}


/* ================= HOME ================= */

#home {

    background: #F7F2FA;

    display: none;

    align-items: center;

    justify-content: center;

    text-align: center;
}


#home.active {

    display: flex;
}


.home-content {

    width: 100%;

    max-width: 900px;
}


.home-content h1 {

    font-size: clamp(45px, 7vw, 90px);

    line-height: 1.05;

    color: #4B3B5A;

    letter-spacing: 2px;
}


.subtitle {

    margin-top: 15px;

    font-size: 25px;

    color: #8064A2;
}


/* ================= PROFILE IMAGE ================= */

.profile-image {

    display: block;

    width: 33vw;

    max-width: 350px;

    min-width: 200px;

    aspect-ratio: 1 / 3;

    object-fit: cover;

    margin: 35px auto 25px;

    border-radius: 20px;

    border: 5px solid white;

    box-shadow:
        0 15px 35px rgba(75, 59, 90, 0.2);
}


/* ================= PERSONAL INFO ================= */

.personal-info {

    border: 2px solid #C9B8D9;

    background: white;

    border-radius: 18px;

    padding: 25px;

    max-width: 600px;

    margin: auto;

    box-shadow:
        0 10px 25px rgba(75, 59, 90, 0.1);
}


.personal-info h2 {

    color: #4B3B5A;

    font-size: 30px;
}


.personal-info p {

    font-size: 19px;

    margin-top: 5px;
}


/* ================= PAGE TITLE ================= */

.page-title {

    text-align: center;

    font-size: clamp(45px, 6vw, 75px);

    color: #4B3B5A;

    margin-bottom: 45px;
}


/* ================= CONTENT BOX ================= */

.content-box {

    max-width: 950px;

    margin: 0 auto 30px;

    padding: 35px;

    background: white;

    border: 2px solid #C9B8D9;

    border-radius: 20px;

    box-shadow:
        0 10px 25px rgba(75, 59, 90, 0.08);
}


.content-box h2 {

    color: #8064A2;

    font-size: 28px;

    margin-bottom: 15px;
}


.content-box p {

    font-size: 18px;

    line-height: 1.8;

    margin-bottom: 12px;
}


/* ================= PROFILE ================= */

.profile-grid {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;
}


.profile-grid p {

    padding: 8px 0;

    border-bottom: 1px solid #E8D9EF;
}


/* ================= ACTIVITIES ================= */

.activity-card {

    max-width: 1000px;

    margin: 0 auto 35px;

    padding: 25px;

    background: white;

    border: 2px solid #C9B8D9;

    border-radius: 20px;

    display: grid;

    grid-template-columns: 300px 1fr;

    gap: 30px;

    align-items: center;

    box-shadow:
        0 10px 25px rgba(75, 59, 90, 0.08);
}


.activity-card img {

    width: 100%;

    border-radius: 12px;

    border: 1px solid #C9B8D9;
}


.activity-card h2 {

    color: #8064A2;

    margin-bottom: 12px;
}


.activity-card p {

    line-height: 1.8;

    margin-bottom: 10px;
}


/* ================= CONTACT ================= */

.contact-box {

    max-width: 700px;

    margin: auto;

    display: flex;

    flex-direction: column;

    gap: 20px;
}


.contact-item {

    display: flex;

    align-items: center;

    gap: 20px;

    padding: 25px;

    background: white;

    border: 2px solid #C9B8D9;

    border-radius: 18px;

    box-shadow:
        0 10px 25px rgba(75, 59, 90, 0.08);
}


.contact-item > span {

    font-size: 35px;
}


.contact-item h2 {

    color: #8064A2;
}


.contact-item p {

    font-size: 18px;
}


/* ================= MOBILE ================= */

@media (max-width: 800px) {

    .sidebar {

        position: fixed;

        left: 10px;
        right: 10px;

        top: 10px;

        transform: none;

        width: auto;

        padding: 8px;

        display: grid;

        grid-template-columns: repeat(5, 1fr);

        border-radius: 15px;
    }


    .logo {

        display: none;
    }


    .sidebar button {

        font-size: 12px;

        padding: 8px 4px;
    }


    .page {

        padding:

            100px

            20px

            40px;
    }


    .profile-grid {

        grid-template-columns: 1fr;
    }


    .activity-card {

        grid-template-columns: 1fr;

        gap: 20px;
    }


    .activity-card img {

        max-width: 400px;

        margin: auto;
    }


    .home-content h1 {

        font-size: 45px;
    }

}
```
```javascript
function showPage(pageId) {

    // ซ่อนทุกหน้า
    const pages = document.querySelectorAll('.page');

    pages.forEach(page => {

        page.classList.remove('active');

    });


    // แสดงหน้าที่เลือก
    const selectedPage = document.getElementById(pageId);

    if (selectedPage) {

        selectedPage.classList.add('active');

    }


    // เลื่อนกลับไปด้านบน
    window.scrollTo({

        top: 0,

        behavior: "smooth"

    });

}
```
